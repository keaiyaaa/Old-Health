<?xml version="1.0" encoding="utf-8"?>
<!--
  语音记录属于「敏感个人信息」，不参与云备份与设备迁移。
  与 AndroidManifest 的 android:allowBackup="false" 双重保障。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

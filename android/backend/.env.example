# 复制为 .env 后填写。密钥不入库不入仓（AGENTS.md 5.3）。
# 生成密钥：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
APP_JWT_SECRET=change-me
APP_AES_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY
APP_HMAC_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY

# 对象存储（境内；local=开发用本地目录，s3=OSS/COS）
APP_STORAGE_BACKEND=local
# APP_S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
# APP_S3_BUCKET=cogni-audio
# APP_S3_ACCESS_KEY=
# APP_S3_SECRET_KEY=

# ASR（C3 未选型：mock=开发；选型后填 http 与厂商地址）
APP_ASR_PROVIDER=mock
# APP_ASR_HTTP_URL=
# APP_ASR_HTTP_KEY=

# 研究模式（默认关闭；关闭时 /v1/research/* 全部 404）
APP_RESEARCH_MODE_ENABLED=false
